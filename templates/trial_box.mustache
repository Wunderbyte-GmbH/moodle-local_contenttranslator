{{!
    @template local_contenttranslator/trial_box

    Free trial box of the setup wizard: start the Wunderbyte trial or reuse the Wunderbyte AI provider of the site.

    Context variables required for this template:
    * connected, reusable, available, noprovider, coreaiunavailable - exactly one is true (state of the trial)
    * sharedcredit - the trial credit is shared with other Wunderbyte AI features (show the note)
    * overwrite - Moodle 4.5: starting the trial replaces an existing provider configuration
    * installurl - where to get the Wunderbyte AI provider plugin

    Example context (json):
    {
        "connected": false,
        "reusable": false,
        "available": true,
        "noprovider": false,
        "coreaiunavailable": false,
        "sharedcredit": true,
        "overwrite": false,
        "installurl": "https://github.com/Wunderbyte-GmbH/moodle-aiprovider_wunderbyte"
    }
}}
<div class="local-contenttranslator-trial card mb-4" data-region="local-contenttranslator-trial">
    <div class="card-body">
        <h3 class="h5 card-title">{{#str}}trial_box_heading, local_contenttranslator{{/str}}</h3>
        {{#connected}}
            <div class="alert alert-success">{{#str}}trial_box_connected, local_contenttranslator{{/str}}</div>
        {{/connected}}
        {{#reusable}}
            <p>{{#str}}trial_box_reusable, local_contenttranslator{{/str}}</p>
        {{/reusable}}
        {{#available}}
            <p>{{#str}}trial_box_intro, local_contenttranslator{{/str}}</p>
        {{/available}}
        {{#noprovider}}
            <div class="alert alert-warning">
                {{#str}}trial_provider_required, local_contenttranslator, <a href="{{installurl}}" target="_blank" rel="noopener noreferrer">{{installurl}}</a>{{/str}}
            </div>
        {{/noprovider}}
        {{#coreaiunavailable}}
            <div class="alert alert-warning">{{#str}}trial_coreai_unavailable, local_contenttranslator{{/str}}</div>
        {{/coreaiunavailable}}
        {{#sharedcredit}}
            <p class="text-muted small">{{#str}}trial_box_sharedcredit, local_contenttranslator{{/str}}</p>
        {{/sharedcredit}}
        {{#reusable}}
            <button type="button" class="btn btn-primary" data-action="local-contenttranslator-trial-start"
                data-needsconsent="0" data-overwrite="0">
                {{#str}}trial_button_reuse, local_contenttranslator{{/str}}
            </button>
        {{/reusable}}
        {{#available}}
            <button type="button" class="btn btn-primary" data-action="local-contenttranslator-trial-start"
                data-needsconsent="1" data-overwrite="{{#overwrite}}1{{/overwrite}}{{^overwrite}}0{{/overwrite}}">
                {{#str}}trial_button_start, local_contenttranslator{{/str}}
            </button>
        {{/available}}
        <div class="mt-3" data-region="local-contenttranslator-trial-spinner" hidden>
            {{#pix}}i/loading, core{{/pix}} {{#str}}trial_working, local_contenttranslator{{/str}}
        </div>
        <div class="mt-3" data-region="local-contenttranslator-trial-result" aria-live="polite"></div>
    </div>
</div>
